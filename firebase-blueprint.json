{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "Master order information",
      "type": "object",
      "properties": {
        "buyer": { "type": "string" },
        "style": { "type": "string" },
        "poNo": { "type": "string" },
        "shipDate": { "type": "string" },
        "color": { "type": "string" },
        "orderQty": { "type": "number" }
      },
      "required": ["buyer", "style", "poNo", "shipDate", "color", "orderQty"]
    },
    "ProductionEntry": {
      "title": "Production Entry",
      "description": "Daily production data",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "poNo": { "type": "string" },
        "color": { "type": "string" },
        "cut": { "type": "number" },
        "sewOut": { "type": "number" },
        "washR": { "type": "number" },
        "finIn": { "type": "number" },
        "finOut": { "type": "number" },
        "poly": { "type": "number" },
        "shipment": { "type": "number" },
        "lineNo": { "type": "string" },
        "floor": { "type": "string", "enum": ["Woven", "Knit", ""] },
        "violations": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["date", "poNo", "color"]
    },
    "User": {
      "title": "User",
      "description": "Application user profile",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["super-admin", "admin", "supervisor", "operator", "viewer"] },
        "permissions": { 
          "type": "array", 
          "items": { "type": "string", "enum": ["view-data", "add-entry", "edit-entry", "delete-entry", "manage-orders", "download-pdf", "view-reports", "manage-users", "change-settings"] } 
        },
        "lastLogin": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "AuditLog": {
      "title": "Audit Log",
      "description": "History of system changes. Admins can clear these logs.",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "action": { "type": "string", "enum": ["ADD", "EDIT", "DELETE", "LOGIN"] },
        "entity": { "type": "string", "enum": ["ORDER", "ENTRY", "USER"] },
        "details": { "type": "string" },
        "path": { "type": "string" }
      },
      "required": ["timestamp", "userId", "action"]
    },
    "FinishingTrackingEntry": {
      "title": "Finishing Tracking Entry",
      "description": "Specific independent tracking for finishing input and output",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "style": { "type": "string" },
        "poNo": { "type": "string" },
        "color": { "type": "string" },
        "lineNo": { "type": "string" },
        "input": { "type": "number" },
        "output": { "type": "number" },
        "orderQty": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" }
      },
      "required": ["date", "style", "poNo", "color", "lineNo", "input", "output", "userId"]
    },
    "DashboardConfig": {
      "title": "Dashboard Configuration",
      "description": "Custom analytics layout preferences for users",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "visibleBlocks": {
          "type": "object",
          "properties": {
            "overview": { "type": "boolean" },
            "achievement": { "type": "boolean" },
            "productionTrend": { "type": "boolean" },
            "buyerAnalytics": { "type": "boolean" },
            "recentStatus": { "type": "boolean" },
            "gaugeMeter": { "type": "boolean" }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "visibleBlocks"]
    },
    "AppSetting": {
      "title": "Application Settings",
      "description": "Global application appearance and behavior settings",
      "type": "object",
      "properties": {
        "primaryColor": { "type": "string" },
        "fontSize": { "type": "string", "enum": ["xs", "sm", "md", "lg", "xl"] },
        "fontFamily": { "type": "string" },
        "navPosition": { "type": "string", "enum": ["top", "left"] },
        "compactMode": { "type": "boolean" },
        "highContrast": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "ExcelFile": {
      "title": "Excel File Library",
      "description": "Knowledge repository for structured data extraction",
      "type": "object",
      "properties": {
        "fileName": { "type": "string" },
        "uploadedAt": { "type": "string", "format": "date-time" },
        "uploadedBy": { "type": "string" },
        "rowCount": { "type": "number" },
        "content": { "type": "string" }
      },
      "required": ["fileName", "uploadedAt", "uploadedBy", "rowCount", "content"]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of master orders"
    },
    "/entries/{entryId}": {
      "schema": "ProductionEntry",
      "description": "Collection of production entries"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and permissions"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "System activity logs"
    },
    "/finishing_tracking/{entryId}": {
      "schema": "FinishingTrackingEntry",
      "description": "Independent finishing line-wise tracking entries"
    },
    "/dashboard_configs/{userId}": {
      "schema": "DashboardConfig",
      "description": "Per-user dashboard layout customization"
    },
    "/settings/global": {
      "schema": "AppSetting",
      "description": "Global application configuration"
    },
    "/excel_files/{fileId}": {
      "schema": "ExcelFile",
      "description": "Library of uploaded Excel files for data collection"
    }
  }
}
